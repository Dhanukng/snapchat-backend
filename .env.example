SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/snapdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=snapuser
SPRING_DATASOURCE_PASSWORD=snappass
JWT_SECRET=replace-with-a-very-long-and-random-secret-key
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
APP_STORAGE_PATH=./uploads
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SENSITIVE_PER_MINUTE=60
